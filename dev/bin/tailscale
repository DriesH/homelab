#!/usr/bin/env bash
# Fake tailscale CLI for `make dev`. It keeps its state in .dev/tailscale.
# A login "succeeds" 5 seconds after `tailscale up`, and a new login with
# --force-reauth after 30 seconds.
dir="$(cd "$(dirname "$0")/../.." && pwd)/.dev/tailscale"
mkdir -p "$dir"
state="$(cat "$dir/state" 2>/dev/null || echo NeedsLogin)"

case "$1 $2" in
"status --json")
    if [[ "$state" == Running ]]; then
        routes="[]"
        [[ -f "$dir/routes" ]] && routes="[\"$(cat "$dir/routes")\"]"
        tags="[]"
        [[ -f "$dir/tagged" ]] && tags='["tag:homelab"]'
        # A new login keeps the old key working, like the real tailscaled.
        url="" health="[]"
        if [[ -f "$dir/pending" ]]; then
            url="https://login.tailscale.com/a/dev"
            health='["You are logged out. The last login error was: fetch control key: Get \"https://controlplane.tailscale.com/key?v=142\": context canceled"]'
        fi
        cat <<JSON
{"BackendState":"Running","AuthURL":"$url","Health":$health,
 "Self":{"HostName":"homelab","DNSName":"homelab.tail1234.ts.net.","TailscaleIPs":["100.101.102.103"],"PrimaryRoutes":$routes,"Tags":$tags},
 "CurrentTailnet":{"Name":"you@example.com"},
 "Peer":{"1":{"HostName":"iphone","DNSName":"iphone.tail1234.ts.net.","OS":"iOS","TailscaleIPs":["100.90.1.2"],"Online":true},
         "2":{"HostName":"macbook","DNSName":"macbook.tail1234.ts.net.","OS":"macOS","TailscaleIPs":["100.90.1.3"],"Online":false,"LastSeen":"2026-09-29T20:00:00Z"}}}
JSON
    else
        url=""
        [[ -f "$dir/pending" ]] && url="https://login.tailscale.com/a/dev"
        echo "{\"BackendState\":\"NeedsLogin\",\"AuthURL\":\"$url\",\"Health\":[\"You are logged out.\"]}"
        exit 1
    fi
    ;;
"up --reset")
    rm -f "$dir/routes"
    tag="" reauth=""
    for arg in "$@"; do
        [[ "$arg" == --advertise-routes=* ]] && echo "${arg#*=}" >"$dir/routes"
        [[ "$arg" == --advertise-tags=* ]] && tag=1
        [[ "$arg" == --force-reauth ]] && reauth=1
    done
    if [[ "$state" == Running && -z "$reauth" ]]; then
        exit 0
    fi
    if [[ "$state" == Running ]]; then
        touch "$dir/pending"
        printf '\nTo authenticate, visit:\n\n\thttps://login.tailscale.com/a/dev\n'
        sleep 30
        if [[ -n "$tag" ]]; then touch "$dir/tagged"; else rm -f "$dir/tagged"; fi
        rm -f "$dir/pending"
        echo Success.
        exit 0
    fi
    # A login with a tag needs a new login, like the real CLI.
    if [[ -n "$tag" ]]; then touch "$dir/tagged"; else rm -f "$dir/tagged"; fi
    echo NeedsLogin >"$dir/state"
    touch "$dir/pending"
    printf '\nTo authenticate, visit:\n\n\thttps://login.tailscale.com/a/dev\n'
    sleep 5
    rm -f "$dir/pending"
    echo Running >"$dir/state"
    echo Success.
    ;;
"serve status")
    services="{}"
    if compgen -G "$dir/svc-*" >/dev/null; then
        services="{$(for file in "$dir"/svc-*; do printf '"svc:%s":{"TCP":{"443":{"HTTPS":true}}},' "${file##*/svc-}"; done | sed 's/,$//')}"
    fi
    if [[ -f "$dir/serving" ]]; then
        echo "{\"TCP\":{\"443\":{\"HTTPS\":true}},\"Web\":{\"homelab.tail1234.ts.net:443\":{}},\"Services\":$services}"
    else
        echo "{\"Services\":$services}"
    fi
    ;;
"serve --service="*)
    [[ -f "$dir/tagged" ]] || { echo "service hosts must be tagged" >&2; exit 1; }
    name="${2#--service=svc:}"
    touch "$dir/svc-$name"
    echo "Available within your tailnet: https://$name.tail1234.ts.net/"
    ;;
"serve clear")
    rm -f "$dir/svc-${3#svc:}"
    ;;
"serve --bg")
    touch "$dir/serving"
    echo "Available within your tailnet: https://homelab.tail1234.ts.net/"
    ;;
"serve --https=443") rm -f "$dir/serving" ;;
"logout "*)
    echo NeedsLogin >"$dir/state"
    rm -f "$dir/serving" "$dir/routes"
    ;;
*)
    echo "fake tailscale: unknown command: $*" >&2
    exit 1
    ;;
esac
